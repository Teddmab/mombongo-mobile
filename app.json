{
  "expo": {
    "name": "Mombongo",
    "slug": "mombongo",
    "owner": "afrotouch-ou",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "mombongo",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1E6B3F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mombongo.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1E6B3F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.mombongo.mobile",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1182d1e2-14eb-4086-9a6e-c1f08291cf86"
      }
    }
  }
}
