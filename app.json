{
  "expo": {
    "name": "Mombongo",
    "slug": "mombongo",
    "owner": "afrotouch-ou",
    "version": "1.0.0",
    "description": "Finance agricole — investissement, crédit et marché pour l'Afrique",
    "orientation": "portrait",
    "scheme": "mombongo",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1E6B3F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mombongo.mobile",
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1E6B3F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.mombongo.mobile",
      "versionCode": 2,
      "permissions": ["CAMERA", "READ_EXTERNAL_STORAGE", "NOTIFICATIONS", "INTERNET", "VIBRATE"],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.471948196882-iot433nbfg70ctq1efahg13ajgbbjcfq"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1182d1e2-14eb-4086-9a6e-c1f08291cf86"
      }
    }
  }
}
